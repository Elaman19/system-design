NODE_ENV=development
PORT=3000
# fatal|error|warn|info|debug|trace|silent; default: debug in development, info otherwise
# LOG_LEVEL=info

# /ready dependency probe timeout
HEALTH_TIMEOUT_MS=1500
# SIGTERM -> /ready answers 503 -> wait this long for the balancer to notice
# -> stop accepting connections -> wait up to SHUTDOWN_TIMEOUT_MS for in-flight requests
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Enables GET /work (slow DB query) for verifying graceful shutdown under load.
# Each request holds a pool connection, so keep it off in real deployments.
# docker-compose.yml turns it on for the local stack only.
WORK_ENDPOINT_ENABLED=false

# Host-oriented defaults: for running the app or the TypeORM CLI directly on
# the host (npm run start:dev / migration:generate / migration:run), reaching
# Compose's published ports. The app container overrides these to the
# in-network service names — see docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
# Server-side limits of the app's connections, ms (0 = off): wait for a row lock,
# one statement, a transaction left open and idle.
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6379
# Namespaces BullMQ keys in Redis.
BULLMQ_PREFIX=bull
# Adding a job when Redis does not answer within this many ms fails instead of hanging.
QUEUE_ADD_TIMEOUT_MS=3000
# A failed job runs JOB_ATTEMPTS times in total, pausing JOB_BACKOFF_MS * 2^n between runs,
# then stays in "failed" (scripts/jobs.mjs lists and retries those).
JOB_ATTEMPTS=5
JOB_BACKOFF_MS=1000

OPENSEARCH_URL=http://localhost:9200

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=devin
S3_SECRET_KEY=devin
S3_REGION=us-east-1
S3_BUCKET=marketplace

# Comma-separated. localhost:9094 is the listener Compose publishes to the host;
# containers use kafka:9092.
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=marketplace
# Prepended to every consumer group name (tests use their own, to stay out of a running stack).
# KAFKA_GROUP_PREFIX=
KAFKA_TOPIC_LOT_VIEWS=lot-views
KAFKA_TOPIC_IP_BANS=ip-bans

# Mailpit catches every mail: nothing leaves the machine. UI: http://localhost:8025
MAIL_SMTP_URL=smtp://localhost:1025
# SMTP connection/greeting/socket timeout. Must stay below DB_IDLE_IN_TRANSACTION_TIMEOUT_MS:
# a receipt is sent inside a transaction that is idle while the mail is on its way.
MAIL_TIMEOUT_MS=10000
MAIL_FROM=Marketplace <noreply@marketplace.local>
ADMIN_EMAIL=admin@marketplace.local

# Outbox relay: sleep when nothing is waiting (ms), rows per pass.
OUTBOX_POLL_MS=500
OUTBOX_BATCH=100

# Views go to Kafka in batches off the request path; the buffer is bounded and drops
# views when Kafka is down.
CLICKSTREAM_LINGER_MS=200
CLICKSTREAM_BUFFER_MAX=10000

# Archiver writes a file to S3 at this many messages or after this long, whichever first.
ARCHIVE_BATCH_SIZE=1000
ARCHIVE_FLUSH_MS=60000

# More than ABUSE_MAX_VIEWS views from one IP within ABUSE_WINDOW_MS: banned for ABUSE_BAN_MS.
ABUSE_MAX_VIEWS=300
ABUSE_WINDOW_MS=60000
ABUSE_BAN_MS=3600000

# Express "trust proxy": which hops may set X-Forwarded-For. Leave empty when clients
# connect directly. Behind a balancer put the balancer's address here, never "true".
# TRUST_PROXY=loopback

# Daily admin report (cron, 5 fields) and its time zone.
DAILY_REPORT_CRON=0 9 * * *
DAILY_REPORT_TZ=UTC
