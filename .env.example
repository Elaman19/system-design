NODE_ENV=development
PORT=3000

# Host-oriented defaults: for running the app or the TypeORM CLI directly on
# the host (npm run start:dev / migration:generate / migration:run), reaching
# Compose's published ports. The app container overrides these to the
# in-network service names — see docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app

REDIS_URL=redis://localhost:6379

OPENSEARCH_URL=http://localhost:9200

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=devin
S3_SECRET_KEY=devin
